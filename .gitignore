# Root-level working notes are private by default; the shipped documents are
# allow-listed below. A new root .md is ignored until it is named here, which is
# deliberate: agent stacks drop instruction files at the repo root.
/*.md
!README.md
# AGENTS.md is the shipped coding-agent guide.
!AGENTS.md
!THIRD_PARTY_NOTICES.md
# Named ahead of time so the standard OSS documents are not silently swallowed
# by the default-deny above if they are ever added.
!CONTRIBUTING.md
!CHANGELOG.md
!SECURITY.md
!CODE_OF_CONDUCT.md

# Internal specification, testing, and brand documents. Kept on disk for
# reference; they describe implementation detail rather than how to use the
# product, and nothing in the source, tests, scripts, or CI reads them.
docs/

# Dependencies
node_modules/
*.lockb
package-lock.json

# TypeScript & Vite (root + app/)
dist/
*.tsbuildinfo

# Vite (test runner cache can live under node_modules; also ignore project-level cache)
.vite/

# Build artifacts
build/
examples/**/target/
examples/go-chat/go-chat

# Generated test/QA evidence (HTML report, screenshots, scratch).
# Unanchored so it also catches nested evidence dirs such as app/output/.
output/

# Generated by scripts/embed-skills.ts before `bun build --compile`.
# Source of truth is skills/<name>/SKILL.md; src/init-skills.ts reads
# those off disk in source mode and only imports this file in the
# compiled binary, so the checked-in copy is just build noise.
src/skills.compiled.ts

# Test & coverage
coverage/

# Environment & secrets
.env
.env.*
!.env.example

# Credential stores. src/secret-store.ts defaults to ~/.runphantom/secrets.json,
# but RUNPHANTOM_SECRET_STORE_PATH can point it anywhere — including in here.
secrets.json
.npmrc
.netrc
id_rsa
id_ed25519
*.crt
*.cer

# Captured trace databases. These hold prompts, tool input/output, and model
# responses, so they must never be publishable. The default lives in
# ~/.runphantom, but RUNPHANTOM_DB_PATH can point anywhere, including here.
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# Archives
*.tgz
*.tar.gz
*.zip

# Debug logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python examples (examples/python-chat)
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
.zed/
*.swp
*.swo
*~

# Tooling caches
.eslintcache
.prettiercache
.cache/

# Local worktrees (parallel agent sessions)
.worktrees/

# Release manifest is generated at tag time by scripts/generate-manifest.ts.
/latest.json

# External repos cloned for local research
/external/

# Playwright artifacts (UI e2e)
app/test-results/
app/playwright-report/

# Recorded demo footage. The capture harness (app/playwright.video.config.ts and
# app/tests-video/*.spec.ts) is source and ships; the rendered media does not —
# a single 1080p take is ~1MB and the catalog runs to hundreds.
app/video-out/
/videos/
*.webm
# Throwaway Playwright driver scripts from manual QA runs
app/__*.mjs

# Isolated Run Phantom databases and local verification scratch
.isolated/

# Playwright MCP scratch (page snapshots, console logs)
.playwright-mcp/

# Ad-hoc screenshots from manual browser testing
/runphantom-*.png

# Agent state and per-agent configuration directories.
.claude/
.codex/
.cursor/
.omc/
.omx/

# Project-scoped agent wiring written by `runphantom setup --local`, which we
# run against this very repo to smoke-test the installer. The MCP entries embed
# the absolute path of the local binary, so they are machine-specific.
/.mcp.json
/opencode.json
/.agents/
