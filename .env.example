# ============================================================================
# Run Phantom — local development environment
#
# Copy to `.env`:  cp .env.example .env
#
# IMPORTANT — who actually reads this file:
#   The Run Phantom DAEMON does NOT read .env. There is no dotenv anywhere in
#   src/. Values below marked [daemon] must be exported in your shell, or set
#   inline, before `bun run dev`.
#   Examples anthropic-chat / openai-chat / python-chat DO read this file
#   (they walk ancestor directories). go-chat and rust-chat do NOT — export
#   those in your shell.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. API KEYS  — every one is OPTIONAL. Core tracing needs none.
# ---------------------------------------------------------------------------
# Capture, storage, search, span inspection, annotations, downloads, and the
# MCP trace-reading/UI tools work with NO key. `ask_agent` needs the provider
# key that matches the captured model before it can return an answer;
# `replay_run` needs a registered local replay endpoint, not an LLM key.

# Unlocks: /api/summarize (span summaries, hardcoded claude-haiku-4-5-20251001)
# and Anthropic-backed ask-agent flows and examples.
# Also settable in the UI under Settings; stored at ~/.runphantom/secrets.json.
ANTHROPIC_API_KEY=

# Unlocks: built-in demo chat (POST /api/demo-chat) and the openai-chat,
# python-chat, go-chat, rust-chat examples.
OPENAI_API_KEY=

# Daemon-only alias for the OpenAI key (src/secret-store.ts:15).
# The OpenAI SDK does NOT read this — the examples need OPENAI_API_KEY.
RUNPHANTOM_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 2. MODELS
# ---------------------------------------------------------------------------
# Demo-chat default is "gpt-5.6-luna". Verify that model id
# against the current OpenAI catalog before relying on it — if it 404s, set a
# known-good id here.
# NOTE: this path is UNREACHABLE from the React UI. It only fires if you open
# http://localhost:5947/demo-chat by hand. The UI's "demo" button calls
# /api/demo-traces/replay instead, which makes no provider call at all.
RUNPHANTOM_DEMO_CHAT_MODEL=

# Example apps only.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# NOTE: the /api/summarize model is HARDCODED and cannot be overridden by env.

# ---------------------------------------------------------------------------
# 3. PORTS, PATHS, NETWORK  [daemon — export these, .env will not be read]
# ---------------------------------------------------------------------------
# SEMANTICS FLIP (src/index.ts:55, 562-591):
#   UNSET -> scans upward from 5947 for a free/healthy port.
#   SET   -> exact port enforced; THROWS ":N is already in use" if taken.
RUNPHANTOM_PORT=5947

# If you move Vite off 5948 and forget this, every mutating /api/* call from
# the dev UI returns 403 while GETs keep working — a partial outage that looks
# like a bug rather than a config error (src/server.ts:579-582).
RUNPHANTOM_UI_PORT=5948
RUNPHANTOM_DB_PATH=
RUNPHANTOM_SECRET_STORE_PATH=
RUNPHANTOM_URL=http://127.0.0.1:5947

# Standard OTLP target your instrumented app exports to.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:5947/v1/traces

# ---------------------------------------------------------------------------
# 4. SECURITY  — read this section before changing anything in it
# ---------------------------------------------------------------------------
# Bind interface. Default 127.0.0.1. Honored only by `serve`/`start`
# (src/index.ts:31-34); port-check.ts and scripts/dev-all.ts always use
# loopback regardless. Widening this alone grants nothing — server.ts:595-607
# still rejects non-loopback source IPs.
RUNPHANTOM_BIND_HOST=127.0.0.1

# Leave all three EMPTY unless you have a specific reason. Each one widens the
# guard that is currently the only thing stopping a website from driving the
# daemon.
RUNPHANTOM_ALLOWED_HOSTS=
RUNPHANTOM_ALLOWED_ORIGINS=
RUNPHANTOM_ALLOWED_SOURCE_IPS=

# ---- DANGEROUS DEFAULTS — both agent paths ship with rails OFF ----
#
# The local side-panel agent runs with permission checks DISABLED by default:
#   src/claude-cli-chat.ts:68  -> --permission-mode bypassPermissions
#   src/codex-cli-chat.ts:52   -> --dangerously-bypass-approvals-and-sandbox
#
# Combined with the fact that ORIGINLESS requests are accepted by design
# (src/local-origin-guard.ts:69), any local process can POST to
# /api/agent/messages and get arbitrary code execution as you.
#
# Neither var can WEAKEN anything — the defaults are already the weakest
# setting. Setting them can only tighten. Uncomment to restore the rails:
# RUNPHANTOM_CLAUDE_PERMISSION_MODE=default
# RUNPHANTOM_CODEX_BYPASS_PERMISSIONS=0
#
# TRAP (src/codex-cli-chat.ts:52): the test is a strict `!== "0"` string
# compare. `false`, `no`, `off`, and `0 ` (trailing space) ALL STILL BYPASS.
# Only the exact one-character string "0" disables it.
#
# FOOTGUN: the two lines below are read ONLY when BYPASS_PERMISSIONS is
# exactly "0". Setting them alone has ZERO effect — you will believe you
# hardened Codex and you will not have.
# RUNPHANTOM_CODEX_SANDBOX=workspace-write
# RUNPHANTOM_CODEX_APPROVAL_POLICY=on-request

# Set to 0 to disable the Claude CLI side-panel chat entirely.
RUNPHANTOM_CLAUDE_CLI_CHAT=

# ---------------------------------------------------------------------------
# 5. AGENT INTEGRATION
# ---------------------------------------------------------------------------
RUNPHANTOM_AGENT_PROVIDER=claude
RUNPHANTOM_CLAUDE_BIN=
RUNPHANTOM_CODEX_BIN=
CLAUDE_CONFIG_DIR=
CODEX_HOME=
# Node is required IN ADDITION to Bun for the Claude AskUserQuestion hook.
RUNPHANTOM_HOOK_NODE_BIN=node
RUNPHANTOM_LOCAL_DEBUGGER=http://127.0.0.1:5947/v1/

# ---------------------------------------------------------------------------
# 6. TEST / DEV ONLY
# ---------------------------------------------------------------------------
# Local replay needs no provider key. It posts to the registered local replay
# endpoint; that endpoint owns any provider authentication it requires.

RUNPHANTOM_SEED_SALT=
RUNPHANTOM_SKIP_START=
RUNPHANTOM_SKIP_STARTUP=
RUNPHANTOM_SKIP_WORKSPACE_ACTIVATE=
RUNPHANTOM_SETUP_TTY=
RUNPHANTOM_SCREENSHOT_DIR=
# Truthy => daemon stops serving the built UI (src/server.ts:2249-2253); use Vite
# on 5948 instead. /api and /v1 routes are unaffected. Not a security control.
RUNPHANTOM_DEV=
NO_COLOR=
PLAYWRIGHT_USE_SYSTEM_CHROME=
CI=
# Overrides the executable path written into every agent MCP config during
# `runphantom setup` (src/install/apply.ts:78).
RUNPHANTOM_BIN_PATH=
# Only for the compiled-binary e2e gate; that test SKIPS when unset.
RUNPHANTOM_COMPILED_URL=
# The ONLY genuinely required var in the repo, and only for
# scripts/upgrade-path-smoke.sh (exits 2 without it).
RUNPHANTOM_BASELINE_BINARY=
